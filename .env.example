# Скопируй в .env: cp .env.example .env
# docker-compose читает эти значения (с дефолтами), api будет валидировать их на старте.

# --- PostgreSQL ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Mailpit (локальная почта) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
